# NetBox REST token with the permissions required by the chosen qualification.
NETBOX_URL=https://netbox.example
NETBOX_TOKEN=nbt_key.plaintext

# Optional remote Diode credentials; TurboBulk qualification does not use them.
DIODE_TARGET=grpc://ingress.example/diode
DIODE_CLIENT_ID=
DIODE_CLIENT_SECRET=

# Remote Diode's ingestion API does not set or expose the tenant's effective
# branch or Assurance mode. Confirm those externally before each run. The source
# may be a settings URL or operations ticket; the timestamp expires after 24h.
DIODE_MODE=direct
DIODE_BRANCH=
DIODE_CONFIG_SOURCE=
DIODE_CONFIG_CONFIRMED_AT=
DIODE_WRITES=0

# Read-only discovery cannot prove these write policies. Enable only the mode
# configured for this disposable target. Main writes apply only without Branching.
TURBOBULK_WRITES=0
ALLOW_MAIN_WRITES=0
